generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ticket {
  id              Int             @id @default(autoincrement())
  sandboxId       String
  sandbox         Sandbox         @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  code            String          @unique
  title           String
  description     String
  requesterName   String
  requesterArea   String
  sourceChannel   String
  status          String          @default("open")
  priority        String
  impact          String
  urgency         String
  categoryId      Int?
  category        Category?       @relation(fields: [categoryId], references: [id])
  aiStatus        String          @default("not_analyzed")
  aiProvider      String?
  aiConfidence    String?
  summary         String?
  possibleCause   String?
  responsibleArea String?
  suggestedReply  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  suggestedSteps  SuggestedStep[]
  notes           TicketNote[]
  events          TicketEvent[]
  @@index([sandboxId, createdAt])
}

model Category {
  id              Int      @id @default(autoincrement())
  sandboxId       String
  sandbox         Sandbox  @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  name            String
  description     String
  color           String
  responsibleArea String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tickets         Ticket[]
  @@unique([sandboxId, name])
}

model Sandbox {
  id        String   @id
  expiresAt DateTime
  requests  Int      @default(0)
  mutations Int      @default(0)
  analyses  Int      @default(0)
  tickets   Ticket[]
  categories Category[]
  @@index([expiresAt])
}

model DemoBudget {
  id       String @id
  sessions Int    @default(0)
  analyses Int    @default(0)
}

model SuggestedStep {
  id       Int    @id @default(autoincrement())
  ticketId Int
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  order    Int
  text     String
}

model TicketNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model TicketEvent {
  id          Int      @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type        String
  description String
  createdAt   DateTime @default(now())
}
